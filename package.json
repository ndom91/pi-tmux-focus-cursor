{
  "name": "pi-tmux-cursor-focus",
  "version": "0.1.3",
  "description": "Pi extension that hides the editor cursor in unfocused tmux panes without replacing other editor/status extensions",
  "author": "ndom91",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tmux",
    "focus",
    "cursor",
    "tui"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "do-release": "./scripts/release.sh"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "index.js",
  "files": [
    "README.md",
    "package.json",
    "index.js"
  ],
  "pi": {
    "extensions": [
      "./index.js"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  }
}
